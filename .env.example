# ---- Free SEO Website Checker ----

# Google Apps Script Web App URL that appends lead rows to your Google Sheet.
# Each lead (name, email, phone, website, score, timestamp, plus device,
# browser, OS, language, timezone, screen, referrer, location and IP) is POSTed here.
# If unset, the report still unlocks for visitors but leads are NOT saved.
# See docs/seo-checker.md for the Apps Script snippet and deploy steps.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional fallback boost: comma-separated apex domains that should always score
# high (for client sites where the Search Atlas / OTTO snippet is injected
# client-side and is not visible in server-fetched HTML).
# Example: SEARCH_ATLAS_ALLOWLIST=acmeplumbing.com,clientsite.io
SEARCH_ATLAS_ALLOWLIST=

# ---- Client Portal (Supabase) ----
# See SETUP-portal.md for provisioning + seeding steps. When these are unset the
# portal shows a "not configured" state and the marketing site is unaffected.

# Supabase project URL + anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Grants full DB access (bypasses RLS). Never
# prefix with NEXT_PUBLIC and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL used to build auth redirect links (invite / password reset).
# No trailing slash. Example: https://riseridge.io
NEXT_PUBLIC_SITE_URL=

# ---- Client Portal — Phase 2 (email + trend alerts), not required for MVP ----
# RESEND_API_KEY=
# PORTAL_FROM_EMAIL=reports@riseridge.io
# CRON_SECRET=
# TREND_ALERT_THRESHOLD_PCT=25
